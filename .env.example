# ============================================================================
# Antigravity Remote Control (self-hosted) — configuration
# ============================================================================
# Copy to .env and fill in. Everything is optional: without credentials the
# container walks you through a one-time interactive sign-in instead
# (docker compose run --rm antigravity-remote).

# --- Antigravity credentials (optional) ---------------------------------------
# Export these from a machine already logged in to Antigravity:
#   ./scripts/export-credentials.sh >> .env
# They are only seeded into the container on first start; tokens the daemon
# refreshes afterwards take precedence.
OAUTH_CREDS_JSON=
JETSKI_STANDALONE_OAUTH_TOKEN_B64=
AGY_OAUTH_TOKEN_B64=
GOOGLE_ACCOUNTS_JSON=

# --- Optional ------------------------------------------------------------------
# Instance name shown in the Remote Control dashboard. If unset, the daemon
# keeps the previously saved name or generates one on first run.
#AGY_HOSTNAME=my-server
# Git identity used inside workspaces.
GIT_USER_NAME=
GIT_USER_EMAIL=
# GitHub token so the agent can push / open PRs.
GITHUB_TOKEN=
