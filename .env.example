# ============================================================================
# Antigravity Remote (self-hosted) — configuration
# ============================================================================
# Copy to .env and fill in. Everything here is a secret except the hub URL.

# --- Hub binary (build-time) -------------------------------------------------
# Required: the Linux tarball of the *Antigravity 2.0* app (the hub / agent
# manager) from the "Antigravity 2.0" section of
# https://antigravity.google/download — e.g.
#   https://storage.googleapis.com/antigravity-public/antigravity-hub/2.8.1-6512087774658560/linux-x64/Antigravity.tar.gz
# Do NOT use https://antigravity.google/download/linux — that page serves the
# Antigravity *IDE* (VS Code fork), whose language server has no embedded web
# UI; the build rejects it.
ANTIGRAVITY_HUB_URL=
# Optional integrity check (sha512sum of the archive).
ANTIGRAVITY_HUB_SHA512=

# --- Antigravity credentials -------------------------------------------------
# Export these from a machine logged in to Antigravity:
#   ./scripts/export-credentials.sh >> .env
OAUTH_CREDS_JSON=
JETSKI_STANDALONE_OAUTH_TOKEN_B64=
AGY_OAUTH_TOKEN_B64=
GOOGLE_ACCOUNTS_JSON=

# --- Cloudflare Tunnel -------------------------------------------------------
# Tunnel token from the Cloudflare Zero Trust dashboard (Networks > Tunnels).
# Point the tunnel's public hostname at http://localhost:8765 and gate it with
# Access + WARP. Leave empty to expose only the local 8765 port instead.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional ----------------------------------------------------------------
# Hostname shown for this instance (defaults to the container hostname).
#AGY_HOSTNAME=my-workstation
# Git identity used inside workspaces.
GIT_USER_NAME=
GIT_USER_EMAIL=
# GitHub token so the agent can push / open PRs.
GITHUB_TOKEN=
