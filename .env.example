# Copy to .env and fill in. Generate the credential values by running
# scripts/export-credentials.sh on the machine where you are logged in to
# Antigravity (the IDE or `agy` CLI).

# --- Antigravity credentials (at least one required) -------------------------

# Base64 of ~/.gemini/antigravity-cli/antigravity-oauth-token
AGY_OAUTH_TOKEN_B64=

# Contents of ~/.gemini/oauth_creds.json (raw JSON, single line)
OAUTH_CREDS_JSON=

# --- Git / GitHub (optional) --------------------------------------------------

GIT_USER_NAME=
GIT_USER_EMAIL=
# Personal access token; enables gh CLI + private repo clones over HTTPS
GITHUB_TOKEN=

# --- Optional extras ------------------------------------------------------------

# Base64 of an Antigravity mcp_config.json. WARNING: every warm Antigravity
# harness starts ALL configured MCP servers as long-lived processes
# (~100-400MB RAM each). Leave empty unless you need them from your phone.
MCP_CONFIG_B64=

# Gemini API key (from AI Studio). Enables the separate "Gemini CLI" provider
# as a second agent option. Leave empty to disable it.
GEMINI_API_KEY=

# --- Tuning (defaults are fine) --------------------------------------------------

# connect = warm Antigravity language server, ~1.3s/turn (default)
# cli     = spawn agy per prompt, slower but lower memory
#AGY_ACP_TRANSPORT=connect

# Set false when connecting only over LAN/VPN instead of Paseo's E2EE relay
#PASEO_RELAY_ENABLED=true

# Set true to restore Paseo's stock supervisor process chain (+~325MB RAM)
#PASEO_USE_SUPERVISOR=false
