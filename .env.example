# ============================================================================
# Antigravity & Claude Remote Control (self-hosted) — configuration
# ============================================================================
# Copy to .env and fill in. Everything is optional. Sign-in is not configured
# here by default: the containers walk you through one-time interactive sign-ins:
#   docker compose run --rm antigravity-remote
#   docker compose run --rm claude-remote
# Auth credentials live in the gemini-home and claude-home Docker volumes.

# --- Workspace & Sandbox -----------------------------------------------------
# Workspace directory where agents operate (default: /workspace or /root/dev)
#WORKSPACE_DIR=/workspace
# Allows Claude Code root privileges without permission popups inside the container
IS_SANDBOX=1

# --- Antigravity -------------------------------------------------------------
# Instance name shown in the Antigravity Remote Control dashboard (antigravity.google.com).
# If unset, the daemon keeps the previously saved name or generates one on first run.
#AGY_HOSTNAME=my-server
# Port of the local hub web UI inside the container (default 4400).
#AGY_HUB_PORT=4400

# --- Claude Code -------------------------------------------------------------
# Session name shown in the Claude web / mobile app (defaults to AGY_HOSTNAME or "remote-claude").
#CLAUDE_NAME=my-server-claude
# Optional Claude OAuth token generated via 'claude setup-token' locally.
# Note: Claude Remote Control requires Claude subscription OAuth; ANTHROPIC_API_KEY
# does not support Remote Control.
#CLAUDE_CODE_OAUTH_TOKEN=
# Optional extra flags for Claude (e.g. --dangerously-skip-permissions).
#CLAUDE_EXTRA_ARGS=

# --- Common / Git -----------------------------------------------------------
# Git identity used inside workspaces by both agents.
GIT_USER_NAME=
GIT_USER_EMAIL=
# GitHub token so agents can push / open PRs.
GITHUB_TOKEN=
