# ============================================================================
# Antigravity Remote Control (self-hosted) — configuration
# ============================================================================
# Copy to .env and fill in. Everything is optional. Sign-in is not configured
# here: the container walks you through a one-time interactive sign-in
# (docker compose run --rm antigravity-remote) and stores the token in the
# gemini-home volume.

# Instance name shown in the Remote Control dashboard. If unset, the daemon
# keeps the previously saved name or generates one on first run.
#AGY_HOSTNAME=my-server
# Port of the local hub web UI inside the container (default 4400).
#AGY_HUB_PORT=4400
# Git identity used inside workspaces.
GIT_USER_NAME=
GIT_USER_EMAIL=
# GitHub token so the agent can push / open PRs.
GITHUB_TOKEN=
